@model List<AeroSpec.Web.ViewModels.FanTypeViewModel>
@{
    ViewData["Title"] = "Fan Types";
}

<h1>Fan Types</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Type ID</th>
            <th>Label</th>
            <th>Prefix</th>
            <th>SP Modifier</th>
            <th>Efficiency Modifier</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TypeId</td>
                <td>@item.Label</td>
                <td>@item.Prefix</td>
                <td>@item.SpMod.ToString("F2")</td>
                <td>@item.EffMod.ToString("F2")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>