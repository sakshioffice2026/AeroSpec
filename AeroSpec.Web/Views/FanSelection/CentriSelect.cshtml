@model AeroSpec.Web.ViewModels.FanSelectionResultViewModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Fan Selections";
    ViewData["CentriStep"] = "results";
    ViewData["CentriSelectionId"] = Model.SavedSelectionId;
    Layout = "~/Views/Shared/_LayoutCentriSelect.cshtml";

    var allPoints = Model.Curve.Points.Select(p => p.FanSp)
        .Concat(Model.Curve.Points.Select(p => p.SysSp))
        .Concat(Model.Curve.GhostLow.Select(g => g.Sp))
        .Concat(Model.Curve.GhostHigh.Select(g => g.Sp))
        .Append(Model.Curve.DutySp)
        .ToList();
    var allCfms = Model.Curve.Points.Select(p => p.Cfm)
        .Concat(Model.Curve.GhostLow.Select(g => g.Cfm))
        .Concat(Model.Curve.GhostHigh.Select(g => g.Cfm))
        .Append(Model.Curve.DutyCfm)
        .ToList();

    var minCfm = allCfms.Count > 0 ? allCfms.Min() : 0;
    var maxCfm = allCfms.Count > 0 ? allCfms.Max() : 1;
    var minSp = allPoints.Count > 0 ? Math.Min(0, allPoints.Min()) : 0;
    var maxSp = allPoints.Count > 0 ? allPoints.Max() : 1;

    const int chartWidth = 700;
    const int chartHeight = 320;
    const int padding = 45;

    double ScaleX(double cfm) => maxCfm == minCfm
        ? padding
        : padding + (cfm - minCfm) / (maxCfm - minCfm) * (chartWidth - 2 * padding);

    double ScaleY(double sp) => maxSp == minSp
        ? chartHeight - padding
        : chartHeight - padding - (sp - minSp) / (maxSp - minSp) * (chartHeight - 2 * padding);

    string P(double v) => v.ToString("F1", CultureInfo.InvariantCulture);

    string BuildPolyline(IEnumerable<(double Cfm, double Sp)> pts) =>
        string.Join(" ", pts.Select(p => $"{P(ScaleX(p.Cfm))},{P(ScaleY(p.Sp))}"));

    var fanCurve = BuildPolyline(Model.Curve.Points.Select(p => (p.Cfm, p.FanSp)));
    var sysCurve = BuildPolyline(Model.Curve.Points.Select(p => (p.Cfm, p.SysSp)));
    var ghostLow = BuildPolyline(Model.Curve.GhostLow.Select(g => (g.Cfm, g.Sp)));
    var ghostHigh = BuildPolyline(Model.Curve.GhostHigh.Select(g => (g.Cfm, g.Sp)));
    var dutyX = ScaleX(Model.Curve.DutyCfm);
    var dutyY = ScaleY(Model.Curve.DutySp);

    var feasible = Model.AllResults.Where(r => r.Feasible).OrderByDescending(r => r.EffPct).ToList();
    var excluded = Model.AllResults.Where(r => !r.Feasible).ToList();
    var bestId = feasible.FirstOrDefault()?.SizeId;

    // Payload for the client-side chart hover tooltip — purely a reformat of the
    // already-computed curve points, no new data.
    var chartPayload = new
    {
        viewWidth = chartWidth,
        points = Model.Curve.Points.Select(p => new
        {
            x = ScaleX(p.Cfm),
            y = ScaleY(p.FanSp),
            cfm = p.Cfm,
            sp = p.FanSp,
            eff = p.Eff
        })
    };
    var chartJson = JsonSerializer.Serialize(chartPayload);
}

@await Html.PartialAsync("_CentriStepper")

<div class="summary-bar">
    <span class="chip">@Model.Specification.Cfm.ToString("N0") CFM</span>
    <span class="chip">@Model.Specification.Sp.ToString("F2")" SP</span>
    <span class="chip">@Model.Quote.FanTypeLabel</span>
    <span class="chip">@Model.Specification.Arrangement</span>
    @if (Math.Abs(Model.DensityRatio - 1) > 0.01)
    {
        <span class="chip amber">Density ratio @Model.DensityRatio.ToString("F3")</span>
    }
    else
    {
        <span class="chip green">Standard air</span>
    }
    <a asp-action="Specification" class="edit-link">Edit specification</a>
</div>

<main>
    <div class="wrap">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
            <div>
                <h1 style="font-size:24px;font-weight:700;">Fan selections</h1>
                <p style="font-size:14px;color:var(--muted);margin-top:4px;">
                    @feasible.Count of @Model.AllResults.Count sizes meet this duty point. Sorted by efficiency — highest first.
                </p>
            </div>
            <a asp-action="Specification" class="btn btn-ghost">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                Edit specification
            </a>
        </div>

        @if (!Model.HasFeasibleFan || feasible.Count == 0)
        {
            <div class="card empty-state">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                <p style="font-weight:600;margin-top:10px;">No sizes meet this duty point</p>
                <p style="font-size:13px;color:var(--muted);margin-top:4px;">@(Model.Message ?? "Try relaxing the max tip speed limit, or check the airflow and pressure entered.")</p>
                <div style="margin-top:16px;">
                    <a asp-action="Specification" class="btn btn-ghost">Back to specification</a>
                </div>
            </div>
        }
        else
        {
            <div class="card table-wrap">
                <table class="table" id="js-fan-model-table">
                    <thead>
                        <tr>
                            <th>Model</th>
                            <th>RPM</th>
                            <th>BHP</th>
                            <th>Motor HP</th>
                            <th>Efficiency</th>
                            <th>Outlet Vel.</th>
                            <th>Tip Speed</th>
                            <th>Sound</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in feasible)
                        {
                            var effColor = r.EffPct >= 70 ? "var(--green)" : r.EffPct >= 55 ? "var(--yellow)" : "var(--red)";
                            <tr class="row-hover @(r.SizeId == bestId ? "best" : "")"
                                data-size-id="@r.SizeId"
                                data-diameter="@r.DiameterIn.ToString("F1", CultureInfo.InvariantCulture)"
                                data-rpm="@r.Rpm"
                                data-bhp="@r.Bhp.ToString("F2", CultureInfo.InvariantCulture)"
                                data-eff="@r.EffPct"
                                data-noise="@r.SoundDba"
                                data-hp="@r.MotorHp">
                                <td>
                                    <div class="mono" style="font-weight:600;">@r.SizeId</div>
                                    @if (r.SizeId == bestId)
                                    {
                                        <span class="recommended-tag">Recommended</span>
                                    }
                                </td>
                                <td class="mono">@r.Rpm.ToString("N0")</td>
                                <td class="mono">@r.Bhp.ToString("F2")</td>
                                <td class="mono">@r.MotorHp</td>
                                <td>
                                    <span class="eff-bar-track"><span class="eff-bar-fill" style="width:@(r.EffPct)%;background:@effColor;"></span></span>
                                    <span class="mono" style="font-size:12px;">@(r.EffPct)%</span>
                                </td>
                                <td class="mono">@r.OutletVelocity.ToString("N0") fpm</td>
                                <td class="mono">@r.TipSpeed.ToString("N0") fpm</td>
                                <td class="mono">@r.SoundDba dBA</td>
                                <td>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (excluded.Count > 0)
            {
                <button class="excluded-toggle" type="button" id="excluded-toggle" data-count="@excluded.Count">
                    Show @excluded.Count excluded size@(excluded.Count > 1 ? "s" : "")
                </button>
                <div class="card pad" id="excluded-panel" style="margin-top:8px;display:none;">
                    @foreach (var r in excluded)
                    {
                        <div class="excluded-row">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                            <span class="mono" style="font-weight:600;">@r.SizeId</span>
                            <span style="color:var(--muted);">— @r.Reason</span>
                        </div>
                    }
                </div>
            }

            <div class="card pad" style="margin-top:24px;">
                <div class="section-label">Performance curve — @Model.Quote.SelectedSizeId</div>
                <div class="chart-panel">
                    <div class="chart-legend">
                        <div class="legend-items">
                            <span class="legend-item"><span class="legend-swatch" style="background:var(--amber);"></span>Fan curve</span>
                            <span class="legend-item"><span class="legend-swatch" style="background:#7C93A6;"></span>System curve</span>
                            <span class="legend-item"><span class="legend-swatch" style="background:rgba(228,135,47,.35);"></span>Speed family</span>
                        </div>
                    </div>
                    <div class="chart-holder">
                        <svg id="chart-svg" viewBox="0 0 @chartWidth @chartHeight" style="width:100%;display:block;">
                            <line x1="@padding" y1="@(chartHeight - padding)" x2="@(chartWidth - padding)" y2="@(chartHeight - padding)" stroke="rgba(255,255,255,.2)" stroke-width="1" />
                            <line x1="@padding" y1="@padding" x2="@padding" y2="@(chartHeight - padding)" stroke="rgba(255,255,255,.2)" stroke-width="1" />
                            @if (!string.IsNullOrWhiteSpace(ghostLow))
                            {
                                <polyline points="@ghostLow" fill="none" stroke="rgba(228,135,47,.35)" stroke-width="1.5" />
                            }
                            @if (!string.IsNullOrWhiteSpace(ghostHigh))
                            {
                                <polyline points="@ghostHigh" fill="none" stroke="rgba(228,135,47,.35)" stroke-width="1.5" />
                            }
                            <polyline points="@sysCurve" fill="none" stroke="#7C93A6" stroke-width="2" />
                            <polyline points="@fanCurve" fill="none" stroke="var(--amber)" stroke-width="2.5" />
                            <circle cx="@P(dutyX)" cy="@P(dutyY)" r="5" fill="#fff" stroke="var(--amber)" stroke-width="2" />
                            <line id="chart-cursor-line" x1="0" y1="@padding" x2="0" y2="@(chartHeight - padding)" stroke="rgba(255,255,255,.35)" stroke-width="1" style="display:none;" />
                            <circle id="chart-cursor-dot" r="4" fill="#fff" stroke="var(--amber)" stroke-width="2" style="display:none;" />
                            <rect id="chart-hit" x="@padding" y="@padding" width="@(chartWidth - 2 * padding)" height="@(chartHeight - 2 * padding)" fill="transparent" />
                        </svg>
                        <div id="chart-tooltip"></div>
                    </div>
                </div>
                <p class="duty-caption">
                    <strong class="mono" style="color:var(--amber-dark);">Duty point</strong>
                    @Model.Curve.DutyCfm.ToString("N0") CFM @@ @Model.Curve.DutySp.ToString("F2") in. wg
                </p>
            </div>

            @if (Model.SelectedFan != null)
            {
                <div class="card pad" style="margin-top:24px;">
                    <div class="section-label">Technical specifications — <span id="js-selected-fan-model">@Model.SelectedFan.SizeId</span></div>
                    <div class="grid grid-3">
                        <div class="stat-row">
                            <div class="stat-label">Diameter (in)</div>
                            <div class="stat-value-row"><span class="stat-value mono" id="js-spec-diameter">@Model.SelectedFan.DiameterIn.ToString("F1")</span></div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-label">Speed (RPM)</div>
                            <div class="stat-value-row"><span class="stat-value mono" id="js-spec-rpm">@Model.SelectedFan.Rpm</span></div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-label">Power (BHP)</div>
                            <div class="stat-value-row"><span class="stat-value mono" id="js-spec-bhp">@Model.SelectedFan.Bhp.ToString("F2")</span></div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-label">Efficiency (%)</div>
                            <div class="stat-value-row"><span class="stat-value mono" id="js-spec-eff">@Model.SelectedFan.EffPct</span></div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-label">Sound (dBA)</div>
                            <div class="stat-value-row"><span class="stat-value mono" id="js-spec-noise">@Model.SelectedFan.SoundDba</span></div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-label">Motor (HP)</div>
                            <div class="stat-value-row"><span class="stat-value mono" id="js-spec-hp">@Model.SelectedFan.MotorHp</span></div>
                        </div>
                    </div>
                </div>
            }

            <div class="btn-row">
                <a asp-action="Details" asp-route-id="@Model.SavedSelectionId" class="btn btn-ghost">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><line x1="12" y1="11" x2="12" y2="16.5" /><circle cx="12" cy="7.7" r=".1" fill="currentColor" /></svg>
                    View full specification
                </a>
                <a asp-controller="Quote" asp-action="Quote" asp-route-id="@Model.SavedSelectionId" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="8.5" width="14" height="7" rx="1" /><path d="M7 8.5V4h10v4.5" /><path d="M7 15.5V20h10v-4.5" /></svg>
                    Generate quote
                </a>
            </div>
        }
    </div>
</main>

@section Scripts {
    <script>
        window.__aeroCurve = @Html.Raw(chartJson);
    </script>
}
