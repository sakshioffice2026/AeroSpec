@model AeroSpec.Web.ViewModels.FanTypeViewModel
@{
    ViewData["Title"] = "Edit Fan Type";
}

<h1>Edit Fan Type</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="TypeId" class="form-label"></label>
                <input asp-for="TypeId" class="form-control" />
                <span asp-validation-for="TypeId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Label" class="form-label"></label>
                <input asp-for="Label" class="form-control" />
                <span asp-validation-for="Label" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Prefix" class="form-label"></label>
                <input asp-for="Prefix" class="form-control" />
                <span asp-validation-for="Prefix" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SpMod" class="form-label"></label>
                <input asp-for="SpMod" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="SpMod" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EffMod" class="form-label"></label>
                <input asp-for="EffMod" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="EffMod" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}