@model List<AeroSpec.Web.ViewModels.FanSelectionHistoryViewModel>
@{
    ViewData["Title"] = "Selection History";
}

<h1>Selection History</h1>

<p>
    <a asp-action="Specification" class="btn btn-primary">New Selection</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Project</th>
            <th>Tag</th>
            <th>CFM</th>
            <th>SP</th>
            <th>Fan Type</th>
            <th>Size</th>
            <th>RPM</th>
            <th>Motor HP</th>
            <th>Efficiency</th>
            <th>Qty</th>
            <th>Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProjectName</td>
                <td>@item.Tag</td>
                <td>@item.RequiredCfm.ToString("N0")</td>
                <td>@item.RequiredSp.ToString("F2")</td>
                <td>@item.FanType</td>
                <td>@item.SelectedFanId</td>
                <td>@item.SelectedRpm</td>
                <td>@item.SelectedMotorHp</td>
                <td>@item.SelectedEfficiency.ToString("F1")%</td>
                <td>@item.Quantity</td>
                <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Results" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Results</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this selection?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>