@model AeroSpec.Web.ViewModels.FanSizeViewModel
@{
    ViewData["Title"] = "Edit Fan Size";
}

<h1>Edit Fan Size</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="SizeId" class="form-label"></label>
                <input asp-for="SizeId" class="form-control" />
                <span asp-validation-for="SizeId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DiameterIn" class="form-label"></label>
                <input asp-for="DiameterIn" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="DiameterIn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CfmScale" class="form-label"></label>
                <input asp-for="CfmScale" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="CfmScale" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SpScale" class="form-label"></label>
                <input asp-for="SpScale" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="SpScale" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MaxRpm" class="form-label"></label>
                <input asp-for="MaxRpm" class="form-control" type="number" />
                <span asp-validation-for="MaxRpm" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OutletArea" class="form-label"></label>
                <input asp-for="OutletArea" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="OutletArea" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="WeightBase" class="form-label"></label>
                <input asp-for="WeightBase" class="form-control" type="number" />
                <span asp-validation-for="WeightBase" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BasePrice" class="form-label"></label>
                <input asp-for="BasePrice" class="form-control" type="number" />
                <span asp-validation-for="BasePrice" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}