@model List<AeroSpec.Web.ViewModels.FanSizeViewModel>
@{
    ViewData["Title"] = "Fan Sizes";
}

<h1>Fan Sizes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Size ID</th>
            <th>Diameter (in)</th>
            <th>CFM Scale</th>
            <th>SP Scale</th>
            <th>Max RPM</th>
            <th>Outlet Area (sq ft)</th>
            <th>Base Weight (lb)</th>
            <th>Base Price ($)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SizeId</td>
                <td>@item.DiameterIn.ToString("F2")</td>
                <td>@item.CfmScale.ToString("F2")</td>
                <td>@item.SpScale.ToString("F2")</td>
                <td>@item.MaxRpm</td>
                <td>@item.OutletArea.ToString("F2")</td>
                <td>@item.WeightBase</td>
                <td>@item.BasePrice.ToString("C0")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete fan size @item.SizeId?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>