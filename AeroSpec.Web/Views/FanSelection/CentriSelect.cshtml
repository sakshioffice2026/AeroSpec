@model AeroSpec.Web.ViewModels.FanSelectionResultViewModel
@using System.Globalization
@{
    ViewData["Title"] = "CENTRI_SELECT | Fan Selection Tool";
    Layout = "~/Views/Shared/_LayoutCentriSelect.cshtml";

    var allPoints = Model.Curve.Points.Select(p => p.FanSp)
        .Concat(Model.Curve.Points.Select(p => p.SysSp))
        .Concat(Model.Curve.GhostLow.Select(g => g.Sp))
        .Concat(Model.Curve.GhostHigh.Select(g => g.Sp))
        .Append(Model.Curve.DutySp)
        .ToList();
    var allCfms = Model.Curve.Points.Select(p => p.Cfm)
        .Concat(Model.Curve.GhostLow.Select(g => g.Cfm))
        .Concat(Model.Curve.GhostHigh.Select(g => g.Cfm))
        .Append(Model.Curve.DutyCfm)
        .ToList();

    var minCfm = allCfms.Count > 0 ? allCfms.Min() : 0;
    var maxCfm = allCfms.Count > 0 ? allCfms.Max() : 1;
    var minSp = allPoints.Count > 0 ? Math.Min(0, allPoints.Min()) : 0;
    var maxSp = allPoints.Count > 0 ? allPoints.Max() : 1;

    const int chartWidth = 700;
    const int chartHeight = 320;
    const int padding = 45;

    double ScaleX(double cfm) => maxCfm == minCfm
        ? padding
        : padding + (cfm - minCfm) / (maxCfm - minCfm) * (chartWidth - 2 * padding);

    double ScaleY(double sp) => maxSp == minSp
        ? chartHeight - padding
        : chartHeight - padding - (sp - minSp) / (maxSp - minSp) * (chartHeight - 2 * padding);

    string BuildPolyline(IEnumerable<(double Cfm, double Sp)> pts) =>
        string.Join(" ", pts.Select(p => $"{ScaleX(p.Cfm).ToString("F1", CultureInfo.InvariantCulture)},{ScaleY(p.Sp).ToString("F1", CultureInfo.InvariantCulture)}"));

    var fanCurve = BuildPolyline(Model.Curve.Points.Select(p => (p.Cfm, p.FanSp)));
    var sysCurve = BuildPolyline(Model.Curve.Points.Select(p => (p.Cfm, p.SysSp)));
    var ghostLow = BuildPolyline(Model.Curve.GhostLow.Select(g => (g.Cfm, g.Sp)));
    var ghostHigh = BuildPolyline(Model.Curve.GhostHigh.Select(g => (g.Cfm, g.Sp)));
    var dutyX = ScaleX(Model.Curve.DutyCfm);
    var dutyY = ScaleY(Model.Curve.DutySp);

    var candidates = Model.AllResults.Where(r => r.Feasible).OrderBy(r => r.DiameterIn).ToList();
    if (candidates.Count == 0)
    {
        candidates = Model.AllResults.ToList();
    }
}

<div class="centri-select-container">

    <!-- Top Navigation Bar -->
    <div class="centri-navbar">
        <div class="centri-brand">
            <a asp-controller="Home" asp-action="Index" class="centri-brand-link">
                <div class="centri-brand-icon"></div>
                <span>CENTRI_SELECT | Fan Selection Tool</span>
            </a>
        </div>

        <div class="centri-breadcrumb">
            <span>Main | @Model.Specification.ProjectName Dashboard</span>
        </div>

        <div class="centri-status-bar">
            <div class="status-item">
                <span class="status-indicator status-active"></span>
                @(Model.HasFeasibleFan ? "System Online" : "Check Selection")
            </div>
            <div class="status-item">🔔</div>
            <div class="status-item">👤</div>
        </div>
    </div>

    <!-- Left Sidebar Navigation -->
    <div class="centri-sidebar">
        <a class="sidebar-nav-item" asp-controller="FanSelection" asp-action="History">
            <span class="sidebar-nav-icon">📁</span>
            <span>Projects</span>
        </a>
        <a class="sidebar-nav-item active" asp-controller="FanSelection" asp-action="Results" asp-route-id="@Model.SavedSelectionId">
            <span class="sidebar-nav-icon">🎯</span>
            <span>Fan Selection</span>
        </a>
        <div class="sidebar-nav-item">
            <span class="sidebar-nav-icon">📊</span>
            <span>Performance Curves</span>
        </div>
        <a class="sidebar-nav-item" asp-controller="FanSelection" asp-action="Specification">
            <span class="sidebar-nav-icon">📋</span>
            <span>Specifications</span>
        </a>
        <a class="sidebar-nav-item" asp-controller="Quote" asp-action="Quote" asp-route-id="@Model.SavedSelectionId">
            <span class="sidebar-nav-icon">📈</span>
            <span>Reports</span>
        </a>
        <div class="sidebar-nav-item">
            <span class="sidebar-nav-icon">⚙️</span>
            <span>Settings</span>
        </div>

        <div class="sidebar-spacer"></div>

        <div class="sidebar-widget">
            <div class="widget-title">3D Preview</div>
            <div class="wireframe-fan">🌀</div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="centri-main">

        @if (!Model.HasFeasibleFan)
        {
            <div class="centri-alert">@Model.Message</div>
        }

        <!-- LEFT COLUMN: Input Parameters -->
        <div class="input-section">

            <div class="input-card">
                <div class="input-card-title">⚡ Operating Parameters</div>
                <div class="readout-row">
                    <span class="readout-label">Airflow (CFM)</span>
                    <span class="readout-value">@Model.Specification.Cfm.ToString("N0")<em>CFM</em></span>
                </div>
                <div class="readout-row">
                    <span class="readout-label">Static Pressure (in. wg)</span>
                    <span class="readout-value">@Model.Specification.Sp.ToString("F2")<em>in.wg</em></span>
                </div>
                <div class="readout-row">
                    <span class="readout-label">Density Ratio</span>
                    <span class="readout-value">@Model.DensityRatio.ToString("F3")<em>ratio</em></span>
                </div>
                <div class="readout-row">
                    <span class="readout-label">Temperature (°F)</span>
                    <span class="readout-value">@Model.Specification.Temperature<em>°F</em></span>
                </div>
                <div class="readout-row">
                    <span class="readout-label">Elevation (ft)</span>
                    <span class="readout-value">@Model.Specification.Elevation<em>ft</em></span>
                </div>
            </div>

            <div class="input-card">
                <div class="input-card-title">🔧 Application Details</div>
                <div class="readout-row">
                    <span class="readout-label">Project</span>
                    <span class="readout-value">@Model.Specification.ProjectName</span>
                </div>
                <div class="readout-row">
                    <span class="readout-label">Tag</span>
                    <span class="readout-value">@(string.IsNullOrWhiteSpace(Model.Specification.Tag) ? "—" : Model.Specification.Tag)</span>
                </div>
                <div class="readout-row">
                    <span class="readout-label">Fan Type</span>
                    <span class="readout-value">@Model.Quote.FanTypeLabel</span>
                </div>
                <div class="readout-row">
                    <span class="readout-label">Arrangement</span>
                    <span class="readout-value">@Model.Specification.Arrangement</span>
                </div>
            </div>

            <div class="input-card">
                <div class="input-card-title">📏 Performance Limits</div>
                <div class="readout-row">
                    <span class="readout-label">Max Tip Speed (fpm)</span>
                    <span class="readout-value">@Model.Specification.MaxTipSpeed.ToString("N0")<em>fpm</em></span>
                </div>
                <div class="readout-row">
                    <span class="readout-label">Sound Limit (dBA)</span>
                    <span class="readout-value">@(Model.Specification.SoundLimit.HasValue ? Model.Specification.SoundLimit.Value.ToString() : "—")<em>dBA</em></span>
                </div>
                <div class="readout-row">
                    <span class="readout-label">Quantity</span>
                    <span class="readout-value">@Model.Specification.Qty</span>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: Results & Visualization -->
        <div class="result-section">

            <!-- Selected Fan Banner -->
            <div id="selected-fan-banner">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="banner-eyebrow">Selected Fan</span>
                        <h3 id="js-selected-fan-title" style="margin: 0.35rem 0;">Fan Type: @Model.Quote.FanTypeLabel</h3>
                        <p style="margin: 0; color: #7a7a7a; font-size: 0.9rem;">Model: <strong id="js-selected-fan-model" class="text-cyan">@Model.Quote.SelectedSizeId</strong></p>
                    </div>
                    <div style="text-align: right;">
                        <span class="badge badge-cyan" style="padding: 0.5rem 1rem;">@(Model.HasFeasibleFan ? "✓ Active Selection" : "⚠ No Feasible Fan")</span>
                    </div>
                </div>
            </div>

            <!-- Performance Curve Chart -->
            <div class="result-card">
                <div class="chart-header">
                    <h4>📊 Performance Curve: System Curve vs Fan Curve</h4>
                    <div class="chart-legend">
                        <span class="legend-item"><span class="legend-dot legend-dot-cyan"></span>Fan Curve</span>
                        <span class="legend-item"><span class="legend-dot legend-dot-pink"></span>System Curve</span>
                    </div>
                </div>
                <div class="chart-fan-row">
                    <div class="chart-container">
                        <svg viewBox="0 0 @chartWidth @chartHeight" class="performance-svg" role="img" aria-label="Fan performance curve">
                            <line x1="@padding" y1="@(chartHeight - padding)" x2="@(chartWidth - padding)" y2="@(chartHeight - padding)" class="axis-line" />
                            <line x1="@padding" y1="@padding" x2="@padding" y2="@(chartHeight - padding)" class="axis-line" />
                            <polyline points="@fanCurve" fill="none" class="curve-fan" />
                            <polyline points="@sysCurve" fill="none" class="curve-system" />
                            @if (!string.IsNullOrWhiteSpace(ghostLow))
                            {
                                <polyline points="@ghostLow" fill="none" class="curve-ghost" />
                            }
                            @if (!string.IsNullOrWhiteSpace(ghostHigh))
                            {
                                <polyline points="@ghostHigh" fill="none" class="curve-ghost" />
                            }
                            <circle cx="@dutyX.ToString("F1", CultureInfo.InvariantCulture)" cy="@dutyY.ToString("F1", CultureInfo.InvariantCulture)" r="5" class="duty-point" />
                        </svg>
                    </div>
                    <div class="fan-visual">
                        <div class="fan-visual-graphic">🌀</div>
                        <span class="fan-visual-caption">Centrifugal Fan (@Model.Quote.SelectedSizeId)</span>
                    </div>
                </div>
                <p class="duty-caption">
                    <strong class="text-cyan">DP</strong> @Model.Curve.DutyCfm.ToString("N0") CFM @@ @Model.Curve.DutySp.ToString("F2") in.wg
                </p>
            </div>

            <!-- Specifications Grid -->
            <div class="result-card">
                <h4 class="section-heading">⚙️ Technical Specifications</h4>
                <div id="spec-metrics-grid">
                    @if (Model.SelectedFan != null)
                    {
                        <div class="spec-card">
                            <div class="spec-label">Diameter (in)</div>
                            <div class="spec-value" id="js-spec-diameter">@Model.SelectedFan.DiameterIn.ToString("F1")</div>
                        </div>
                        <div class="spec-card">
                            <div class="spec-label">Speed (RPM)</div>
                            <div class="spec-value" id="js-spec-rpm">@Model.SelectedFan.Rpm</div>
                        </div>
                        <div class="spec-card">
                            <div class="spec-label">Power (BHP)</div>
                            <div class="spec-value" id="js-spec-bhp">@Model.SelectedFan.Bhp.ToString("F2")</div>
                        </div>
                        <div class="spec-card">
                            <div class="spec-label">Efficiency (%)</div>
                            <div class="spec-value" id="js-spec-eff">@Model.SelectedFan.EffPct</div>
                        </div>
                        <div class="spec-card">
                            <div class="spec-label">Noise (dB(A))</div>
                            <div class="spec-value" id="js-spec-noise">@Model.SelectedFan.SoundDba</div>
                        </div>
                        <div class="spec-card">
                            <div class="spec-label">Motor (HP)</div>
                            <div class="spec-value" id="js-spec-hp">@Model.SelectedFan.MotorHp</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Fan Model Selection -->
            <div class="result-card">
                <h4 class="section-heading">🔄 Select Fan Model</h4>
                <div class="fan-model-carousel" id="js-fan-model-carousel">
                    @foreach (var r in candidates)
                    {
                        <div class="fan-model-card @(r.IsSelected ? "active" : "")"
                             data-size-id="@r.SizeId"
                             data-diameter="@r.DiameterIn.ToString("F1", CultureInfo.InvariantCulture)"
                             data-rpm="@r.Rpm"
                             data-bhp="@r.Bhp.ToString("F2", CultureInfo.InvariantCulture)"
                             data-eff="@r.EffPct"
                             data-noise="@r.SoundDba"
                             data-hp="@r.MotorHp">
                            @if (r.IsSelected)
                            {
                                <span class="fan-model-badge">●</span>
                            }
                            <div class="fan-model-icon">🌀</div>
                            <div class="fan-model-name">@r.SizeId</div>
                            <div class="fan-model-sub">@(r.IsSelected ? "Selected" : "")</div>
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- Action Buttons -->
        <div class="action-rail">
            <a asp-controller="Quote" asp-action="Quote" asp-route-id="@Model.SavedSelectionId" class="btn-cta btn-cta-cyan">
                📄 Generate Report
            </a>
            <a asp-controller="FanSelection" asp-action="Details" asp-route-id="@Model.SavedSelectionId" class="btn-cta btn-cta-orange">
                ✓ Add to Project
            </a>
        </div>

    </div>

</div>
