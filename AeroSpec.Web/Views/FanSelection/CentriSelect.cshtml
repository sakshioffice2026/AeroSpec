@{
    ViewData["Title"] = "CENTRI_SELECT | Centrifugal Fan Selection Tool";
    Layout = "~/Views/Shared/_LayoutCentriSelect.cshtml";
}
    <div class="centri-select-container">
        
        <!-- Top Navigation Bar -->
        <div class="centri-navbar">
            <div class="centri-brand">
                <div class="centri-brand-icon"></div>
                <span>CENTRI_SELECT | Fan Selection Tool</span>
            </div>
            
            <div class="centri-breadcrumb">
                <span>📁 PROJECT: Industrial Ventilation - Factory 3B</span>
            </div>
            
            <div class="centri-status-bar">
                <div class="status-item">
                    <span class="status-indicator"></span>
                    System Online
                </div>
                <div class="status-item">
                    🔔 Notifications
                </div>
                <div class="status-item">
                    👤 Profile
                </div>
            </div>
        </div>
        
        <!-- Left Sidebar Navigation -->
        <div class="centri-sidebar">
            <div class="sidebar-nav-item active">
                <span class="sidebar-nav-icon">🎯</span>
                <span>Fan Selection</span>
            </div>
            <div class="sidebar-nav-item">
                <span class="sidebar-nav-icon">📊</span>
                <span>Performance Curves</span>
            </div>
            <div class="sidebar-nav-item">
                <span class="sidebar-nav-icon">📋</span>
                <span>Specifications</span>
            </div>
            <div class="sidebar-nav-item">
                <span class="sidebar-nav-icon">📈</span>
                <span>Reports</span>
            </div>
            <div class="sidebar-nav-item">
                <span class="sidebar-nav-icon">⚙️</span>
                <span>Settings</span>
            </div>
            
            <div class="sidebar-spacer"></div>
            
            <div class="sidebar-widget">
                <div class="widget-title">3D Preview</div>
                <div class="wireframe-fan">🌀</div>
            </div>
        </div>
        
        <!-- Main Content Area -->
        <div class="centri-main">
            
            <!-- LEFT COLUMN: Input Parameters -->
            <div class="input-section">
                
                <!-- Operating Parameters Card -->
                <div class="input-card">
                    <div class="input-card-title">⚡ Operating Parameters</div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Airflow (m³/h)</label>
                        <div class="input-group">
                            <input type="number" id="airflow-input" class="form-control" value="12500" min="1000" max="25000" step="100">
                            <span class="input-group-text">m³/h</span>
                        </div>
                    </div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Static Pressure (Pa)</label>
                        <div class="input-group">
                            <input type="number" id="pressure-input" class="form-control" value="1600" min="100" max="5000" step="50">
                            <span class="input-group-text">Pa</span>
                        </div>
                    </div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Air Density (kg/m³)</label>
                        <div class="input-group">
                            <input type="number" id="density-input" class="form-control" value="1.2" min="0.8" max="1.5" step="0.1">
                            <span class="input-group-text">kg/m³</span>
                        </div>
                    </div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Temperature (°C)</label>
                        <div class="input-group">
                            <input type="number" id="temperature-input" class="form-control" value="25" min="-20" max="80" step="1">
                            <span class="input-group-text">°C</span>
                        </div>
                    </div>
                </div>
                
                <!-- Application Details Card -->
                <div class="input-card">
                    <div class="input-card-title">🔧 Application Details</div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Duct Type</label>
                        <select id="duct-type-select" class="form-select">
                            <option value="spiral">Spiral Duct</option>
                            <option value="rectangular">Rectangular Duct</option>
                            <option value="flexible">Flexible Duct</option>
                            <option value="rigid">Rigid Duct</option>
                        </select>
                    </div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Motor Voltage (V)</label>
                        <select id="motor-voltage-select" class="form-select">
                            <option value="230">230V Single Phase</option>
                            <option value="380">380V Three Phase</option>
                            <option value="415">415V Three Phase</option>
                            <option value="480">480V Three Phase</option>
                        </select>
                    </div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Frequency (Hz)</label>
                        <select id="frequency-select" class="form-select">
                            <option value="50">50 Hz</option>
                            <option value="60">60 Hz</option>
                        </select>
                    </div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Environment Type</label>
                        <select id="environment-select" class="form-select">
                            <option value="industrial">Industrial</option>
                            <option value="commercial">Commercial</option>
                            <option value="residential">Residential</option>
                            <option value="hazardous">Hazardous</option>
                        </select>
                    </div>
                </div>
                
                <!-- Performance Limits Card -->
                <div class="input-card">
                    <div class="input-card-title">📏 Performance Limits</div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Max Speed (RPM)</label>
                        <div class="input-group">
                            <input type="number" id="max-speed-input" class="form-control" value="1800" min="500" max="3000" step="50">
                            <span class="input-group-text">RPM</span>
                        </div>
                    </div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Max Power (kW)</label>
                        <div class="input-group">
                            <input type="number" id="max-power-input" class="form-control" value="15" min="1" max="50" step="0.5">
                            <span class="input-group-text">kW</span>
                        </div>
                    </div>
                    
                    <div class="input-group-wrapper">
                        <label class="input-label">Size Range</label>
                        <select id="size-range-select" class="form-select">
                            <option value="small">Small (< 1000mm)</option>
                            <option value="medium">Medium (1000-1300mm)</option>
                            <option value="large" selected>Large (> 1300mm)</option>
                        </select>
                    </div>
                </div>
                
            </div>
            
            <!-- RIGHT COLUMN: Results & Visualization -->
            <div class="result-section">
                
                <!-- Selected Fan Banner -->
                <div id="selected-fan-banner">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 style="margin-bottom: 0.5rem;">Centrifugal Airfoil Fan - AF-140-6D</h3>
                            <p style="margin: 0; color: #7a7a7a; font-size: 0.9rem;">Model: <strong>AF-140-6D</strong></p>
                        </div>
                        <div style="text-align: right;">
                            <span class="badge badge-cyan" style="padding: 0.5rem 1rem;">✓ Active Selection</span>
                        </div>
                    </div>
                </div>
                
                <!-- Performance Curve Chart -->
                <div class="result-card">
                    <h4 style="color: var(--cs-cyan-primary); margin-bottom: 1rem; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px;">📊 Performance Curve</h4>
                    <div class="chart-container">
                        <canvas id="performance-chart"></canvas>
                    </div>
                    <p style="font-size: 0.85rem; color: #7a7a7a; margin: 0;">
                    <strong style="color: var(--cs-cyan-primary);">Duty Point:</strong> 12,500 m³/h @@ 1,600 Pa
                </p>
                </div>
                
                <!-- Specifications Grid -->
                <div class="result-card">
                    <h4 style="color: var(--cs-cyan-primary); margin-bottom: 1rem; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px;">⚙️ Technical Specifications</h4>
                    <div id="spec-metrics-grid">
                        <!-- Dynamically populated by JavaScript -->
                    </div>
                </div>
                
                <!-- Fan Model Selection -->
                <div class="result-card">
                    <h4 style="color: var(--cs-cyan-primary); margin-bottom: 1rem; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px;">🔄 Select Fan Model</h4>
                    <div class="fan-model-carousel">
                        <div class="fan-model-card active" data-fan-model="AF-140-6D">
                            <div class="fan-model-icon">⭐</div>
                            <div class="fan-model-name">AF-140-6D</div>
                        </div>
                        <div class="fan-model-card" data-fan-model="AF-130-6D">
                            <div class="fan-model-icon">🌀</div>
                            <div class="fan-model-name">AF-130-6D</div>
                        </div>
                        <div class="fan-model-card" data-fan-model="AF-150-6C">
                            <div class="fan-model-icon">💨</div>
                            <div class="fan-model-name">AF-150-6C</div>
                        </div>
                    </div>
                </div>
                
                <!-- Action Buttons -->
                <div class="action-bar">
                    <button id="generate-report-btn" class="btn-cta btn-cta-cyan">
                        📄 Generate Report
                    </button>
                    <button id="add-to-project-btn" class="btn-cta btn-cta-orange">
                        ✓ Add to Project
                    </button>
                </div>
                
            </div>
            
        </div>
        
    </div>
    

